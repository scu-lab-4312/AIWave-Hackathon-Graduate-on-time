# AWS region used by the currently deployed hackathon environment
AWS_REGION=us-west-2

# Local frontend proxy -> Orchestrator Runtime
# auto: use AgentCore when AGENT_RUNTIME_ARN is set, otherwise run locally;
#       if the remote call fails, safely fall back to the local orchestrator.
# agentcore: require the remote runtime and AWS credentials; local: never call AWS.
FRONTEND_AGENT_MODE=auto
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:ACCOUNT_ID:runtime/ORCHESTRATOR_RUNTIME_ID
PORT=3000

# Orchestrator -> Repair Runtime
REPAIR_AGENT_MODE=agentcore
REPAIR_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:ACCOUNT_ID:runtime/REPAIR_RUNTIME_ID
REPAIR_AGENT_QUALIFIER=DEFAULT
REPAIR_AGENT_FAKE_FALLBACK=true

# Repair Runtime -> AgentCore Gateway
REPAIR_GATEWAY_URL=https://GATEWAY_ID.gateway.bedrock-agentcore.us-west-2.amazonaws.com/mcp
REPAIR_AGENT_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Orchestrator -> Medical Runtime
MEDICAL_AGENT_MODE=agentcore
MEDICAL_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:ACCOUNT_ID:runtime/MEDICAL_RUNTIME_ID
MEDICAL_AGENT_QUALIFIER=DEFAULT
MEDICAL_AGENT_FAKE_FALLBACK=true

# Medical Runtime -> AgentCore Gateway
MEDICAL_GATEWAY_URL=https://GATEWAY_ID.gateway.bedrock-agentcore.us-west-2.amazonaws.com/mcp
MEDICAL_AGENT_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Orchestrator -> Taxi Runtime
TAXI_AGENT_MODE=agentcore
TAXI_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:ACCOUNT_ID:runtime/TAXI_RUNTIME_ID
TAXI_AGENT_QUALIFIER=DEFAULT
TAXI_AGENT_FAKE_FALLBACK=true

# Taxi Runtime -> AgentCore Gateway
TAXI_GATEWAY_URL=https://GATEWAY_ID.gateway.bedrock-agentcore.us-west-2.amazonaws.com/mcp
TAXI_AGENT_MODEL_ID=us.anthropic.claude-sonnet-4-6

# AgentCore Memory IDs are identifiers, never secret values
BEDROCK_AGENTCORE_MEMORY_ID=ORCHESTRATOR_MEMORY_ID
REPAIR_AGENT_MEMORY_ID=REPAIR_MEMORY_ID
# Medical Agent deliberately has no Memory; only city/district cross its boundary.
# Taxi Agent also relies on Orchestrator task state instead of a separate Memory resource.
